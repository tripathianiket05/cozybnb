<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-6 offset-3">
    <h2 class="mb-4">Sign up on CozyBnB</h2>
    
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" id="username" type="text" class="form-control" required />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input name="email" id="email" type="email" class="form-control" required />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" type="password" class="form-control" required />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please enter a password.</div>
      </div>

      <div class="mb-4 mt-4">
        <label class="form-label fw-bold">How will you use CozyBnB?</label>
        <div class="form-check mb-2">
          <input class="form-check-input" type="radio" name="role" id="roleUser" value="user" checked>
          <label class="form-check-label" for="roleUser">
            I want to travel and book places
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="role" id="roleOwner" value="owner">
          <label class="form-check-label" for="roleOwner">
            I want to host my own properties
          </label>
        </div>
      </div>

      <button class="btn btn-success pb-2 mt-2">Sign Up</button>
    </form>
  </div>
</div>